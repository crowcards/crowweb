{
  "hosting": {
    "public": ".",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/stamp-version.mjs\""
    ],
    "ignore": [
      "scripts/**",
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs-site/**",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "CLAUDE.md",
      "DESIGN.md",
      "TODO.md",
      "RECOMMENDATIONS.md",
      "ratings/**",
      "**/*.log",
      "**/*:Zone.Identifier",
      "emulator-data/**",
      "*.local.md"
    ],
    "redirects": [
      { "source": "/docs.html", "destination": "https://docs.crowcards.org/", "type": 301 },
      { "source": "/platforms.html", "destination": "https://docs.crowcards.org/platforms", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/c/**",
        "destination": "/card.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam7",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/copy-shared.mjs\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
