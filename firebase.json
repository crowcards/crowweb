{
  "hosting": {
    "public": ".",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/stamp-version.mjs\""
    ],
    "ignore": [
      "scripts/**",
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs-site/**",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "CLAUDE.md",
      "DESIGN.md",
      "TODO.md",
      "RECOMMENDATIONS.md",
      "ratings/**",
      "**/*.log",
      "**/*:Zone.Identifier",
      "emulator-data/**",
      "*.local.md"
    ],
    "cleanUrls": true,
    "redirects": [
      { "source": "/docs.html", "destination": "https://docs.crowcards.org/", "type": 301 },
      { "source": "/docs", "destination": "https://docs.crowcards.org/", "type": 301 },
      { "source": "/platforms.html", "destination": "https://docs.crowcards.org/platforms", "type": 301 },
      { "source": "/platforms", "destination": "https://docs.crowcards.org/platforms", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/c/**",
        "destination": "/card.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net; font-src 'self' data: https://use.typekit.net; img-src 'self' data: https://use.typekit.net https://p.typekit.net; connect-src 'self' https: http://127.0.0.1:5001 http://localhost:5001; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam7",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/copy-shared.mjs\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
