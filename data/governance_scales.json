{
  "version": "0.3.0",
  "updatedAt": "2026-10-08",
  "note": "Scores for the three governance scales. Options a card can choose (decision approaches, joining tiers and ways, conflict approaches) are scored on what they are: a card's score on a scale is the average of the accepted scores of what it chose (rounded to a whole number, on the same 1–7 range). Values (list \"values\") are scored on where they point: a community that holds the value would tend to want that end; they suggest values from a card's target scales (basics.targetScales). null = says nothing about that scale: left out of a card's average; for suggestions, it counts as neutralDistance (an average fit, neither close nor far). Each scale's levels: what each score means, from range.min to range.max (1, 4 and 7 are the anchors the scores were drafted against). Each scale's ends: the trade-offs of being at the low (1) or high (7) end (pros: what you gain; cons: what it costs), short phrases, with an optional short title where the level's own text is too long for the box, shown when a community chooses its targets. Only status \"accepted\" is used (\"proposed\" = drafted, waiting for the team's review). Review page: scales.html.",
  "range": {
    "min": 1,
    "max": 7
  },
  "neutralDistance": 2,
  "scales": [
    {
      "id": "participatory",
      "label": "Participatory",
      "description": "How widely people can take part and have a say.",
      "levels": [
        "One person, or a few, decide",
        "A small group decides, sometimes asking others",
        "A few decide, after hearing from members",
        "A share of the members take part, or have some say",
        "Most members can have a say; a smaller group decides",
        "Nearly everyone takes part in most decisions",
        "Everyone takes part"
      ],
      "ends": {
        "low": {
          "pros": [
            "Fast decisions, clear ownership",
            "Asks little of members' time"
          ],
          "cons": [
            "Misses what members know",
            "Rests on a few people"
          ]
        },
        "high": {
          "pros": [
            "Draws on everyone's knowledge",
            "Decisions are widely accepted"
          ],
          "cons": [
            "Slower, harder as you grow",
            "Tiring; loud voices can dominate"
          ]
        }
      }
    },
    {
      "id": "transparent",
      "label": "Transparent",
      "description": "How visible the process, the criteria and the reasons are.",
      "levels": [
        "Private: decisions and reasons aren't seen",
        "Some outcomes are shared, rarely the reasons",
        "Outcomes are shared; the reasons only if asked",
        "Outcomes are visible; the reasons and process not always",
        "Outcomes and reasons are shared; the discussion isn't",
        "The process and reasons are mostly open, and recorded",
        "Fully open: the process, discussion and reasons are recorded for all"
      ],
      "ends": {
        "low": {
          "title": "Private",
          "pros": [
            "Protects people's privacy",
            "Room for frank discussion"
          ],
          "cons": [
            "Decisions are hard to check",
            "Misuse can go unnoticed"
          ]
        },
        "high": {
          "title": "Fully open",
          "pros": [
            "Builds trust, leaves a record",
            "Mistakes are easier to spot"
          ],
          "cons": [
            "Can expose sensitive information",
            "Keeping records takes work"
          ]
        }
      }
    },
    {
      "id": "hierarchical",
      "label": "Hierarchical",
      "description": "How much authority sits with particular roles or levels.",
      "levels": [
        "Flat: no role carries more authority",
        "Nearly flat: some roles coordinate, but don't decide",
        "A few roles carry a little more weight",
        "Some roles carry more weight",
        "Clear roles, some with authority over others",
        "Several levels, with most authority near the top",
        "Clear levels, with authority at the top"
      ],
      "ends": {
        "low": {
          "pros": [
            "Every voice weighs the same",
            "Anyone can take initiative"
          ],
          "cons": [
            "Unclear who's responsible",
            "Hidden leaders can emerge"
          ]
        },
        "high": {
          "pros": [
            "Clear responsibility and escalation",
            "Coordinates well at scale"
          ],
          "cons": [
            "Power concentrates",
            "Decisions bottleneck at the top"
          ]
        }
      }
    }
  ],
